# Copy to .dev.vars for local `npm run dev:cf` (Cloudflare Pages Functions).
# In production these are set in Cloudflare Pages > Settings > Variables and Secrets.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
INQUIRY_FROM=LConnectiQ <inquiries@lconnectiq.com>
# Optional, defaults to lc@lconnectiq.com
INQUIRY_TO=lc@lconnectiq.com

# Optional: Cloudflare Turnstile. Use Cloudflare's always-pass test secret locally:
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
